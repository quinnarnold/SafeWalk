# Runtime
NODE_ENV=development
CITY_NAME=boston
PORT=8080
PYTHON_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# Authentication
# Use "disabled" only for local development. Production rejects this mode.
AUTH_MODE=disabled
# Required when AUTH_MODE=app-attest.
APP_ATTEST_APP_ID=TEAMID.com.example.SafeWalk
# Must match CFBundleVersion in the distributed app.
APP_ATTEST_BUNDLE_VERSION=1
# 2=TestFlight, 3=development-signed, 4=App Store, 5=enterprise/ad hoc.
APP_ATTEST_ALLOWED_VALIDATION_CATEGORIES=2,3,4,5

# Mapbox
# Secret token with tokens:write for short-lived runtime token creation.
MAPBOX_TOKEN=
MAPBOX_USERNAME=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional
# Set true only when traffic can reach the API exclusively through a trusted proxy.
TRUST_PROXY=false
OTP_URL=http://localhost:8090
LOG_LEVEL=info
ROUTE_CACHE_TTL_SEC=2592000
MM_CACHE_TTL_SEC=2592000
TRANSIT_CACHE_TTL_SEC=300
