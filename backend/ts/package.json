{
  "name": "safewalk-api",
  "version": "1.0.0",
  "description": "SafeWalk API Layer (Fastify + Bun)",
  "license": "MIT",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "bun": ">=1.3.12"
  },
  "overrides": {
    "fast-uri": "4.1.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "cbor-x": "^1.6.4",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "latest",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript": "~7.0.2"
  }
}
